# Copy to .env and fill in real values. Never commit the .env file itself.

# Async PostgreSQL connection string (required)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/prm

# Anthropic API key used to generate the GDPR removal emails (required)
ANTHROPIC_API_KEY=

# Base URL of the frontend, used to build email verification links
FRONTEND_URL=http://localhost:5173

# Resend, for outbound email delivery. Leaving the key empty disables sending.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_REPLY_TO=

# Signing secret for inbound Resend webhooks, verified with Svix.
# Leaving it empty skips signature verification (local development only).
RESEND_WEBHOOK_SECRET=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Root log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
